#!/bin/sh
# Runs in the installer, with the new system mounted at /target.
# Adds the disk space the recipe left unused to vg0, without growing root.
set -eu

in-target apt-get install -y docker.io
in-target systemctl enable docker.service

install -d -m 700 /target/root/.ssh
if [ -s /cdrom/preseed/authorized_key ]; then
    install -m 600 /cdrom/preseed/authorized_key /target/root/.ssh/authorized_keys
fi

cat > /target/etc/ssh/sshd_config.d/10-vps.conf <<'EOF'
PermitRootLogin prohibit-password
PasswordAuthentication no
KbdInteractiveAuthentication no
EOF

disk="$(debconf-get partman-auto/disk)"
[ -n "$disk" ] && [ -b "$disk" ]

# The recipe's trailing "free" entry is unused disk, not a partition. Cover
# that trailing range with a new partition and add only that partition to vg0.
python3 - "$disk" <<'PY'
import subprocess
import sys

disk = sys.argv[1]
output = subprocess.check_output(
    ["parted", "-s", "-m", disk, "unit", "s", "print", "free"], text=True
)
free = [
    line.split(":")[1:3]
    for line in output.splitlines()
    if line.endswith(":free;")
]
if not free:
    sys.exit("no free space left for the snapshot reserve")
start, end = (value.rstrip("s") for value in free[-1])
if int(end) - int(start) < 2048:
    sys.exit("free space is too small for a snapshot reserve")
subprocess.check_call(
    ["parted", "-s", "-a", "optimal", disk, "unit", "s", "mkpart", "primary", start, end]
)
PY

reserve="$(lsblk -lnpo NAME,TYPE "$disk" | awk '$2 == "part" { print $1 }' | tail -n1)"
[ -b "$reserve" ]
if blkid "$reserve" >/dev/null 2>&1; then
    echo "reserve partition $reserve already has a filesystem or volume label" >&2
    exit 1
fi
pvcreate "$reserve"
vgextend vg0 "$reserve"
vgs vg0
lvs vg0
